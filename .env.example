# Render: configure these as secret environment variables; never commit actual values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cabo_app:localpassword@localhost:5432/cabo_human_capital
SESSION_SECRET=replace-with-at-least-32-strong-random-characters
# Disable one-time setup endpoint by leaving this unset after seeding.
BOOTSTRAP_TOKEN=
# For initial provisioning only, optional (use /api/v1/setup instead).
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Configure only a trusted internal ClamAV daemon. Leave unset to quarantine uploads.
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310

# OFF until privacy launch signoff for genuine applicants
PUBLIC_APPLICATIONS_ENABLED=false
# Exact browser origin. Change this when CABO configures a custom domain.
CABO_PUBLIC_ORIGIN=https://cabo-human-capital.onrender.com

# Default off until tenant/controller and external AI processor privacy approvals are complete
HR_CV_AI_EXTERNAL_ENABLED=false
